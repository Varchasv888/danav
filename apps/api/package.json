{
  "name": "@varchasv/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Varchasv cloud API (Fastify): auth, tenancy, masters, sync and GSP relay.",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "start": "node --env-file=../../.env dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "load-test": "tsx scripts/load-test.ts",
    "docs:api": "tsx scripts/api-docs.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@varchasv/db": "0.1.0",
    "@varchasv/domain": "0.1.0",
    "@varchasv/i18n": "0.1.0",
    "drizzle-orm": "^0.45.3",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.5",
    "nodemailer": "^10.0.14",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "autocannon": "^8.0.0"
  }
}
