# Owner connection: migrations and seed only
DATABASE_OWNER_URL=postgres://varchasv_owner:varchasv_owner_dev@localhost:5433/varchasv
# App connection: RLS enforced
DATABASE_URL=postgres://varchasv_app:varchasv_app_dev@localhost:5433/varchasv
API_PORT=4100
WEB_ORIGIN=http://localhost:3100
SESSION_TTL_DAYS=30
API_URL=http://localhost:4100

# Local development test account (created through the sign-up page; local database only)
DEV_DEMO_EMAIL=demo@varchasv.test
DEV_DEMO_PASSWORD=demo-varchasv-2026

# Optional paid services. Leave empty to use the built-in demo stand-ins; never commit real values.
# Claude: reading receipts and purchase bills, and the assistant.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-sonnet-5-5
# WhatsApp Cloud API: sending template messages and payment reminders.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Email. Without SMTP_URL, emails (invitations, password resets, payslips) are written to the API log.
SMTP_URL=
MAIL_FROM=Varchasv ERP <no-reply@varchasv.in>

# Production only. 32 random bytes, base64; encrypts stored GST portal sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_KEY=
# Session cookies require HTTPS in production. Set to false only for a test server on plain HTTP.
# COOKIE_SECURE=false
