{
  "description": "GST computation cases. Both packages/domain (TS) and the Flutter app (Dart) must produce exactly these outputs. Amounts are strings with 2 decimals.",
  "cases": [
    { "name": "intra-state 18%", "ctx": { "supplierState": "27", "placeOfSupply": "27" },
      "lines": [{ "qty": "2", "rate": "500", "gstRate": "18" }],
      "expect": { "supplyKind": "intra", "taxableValue": "1000.00", "cgst": "90.00", "sgst": "90.00", "utgst": "0.00", "igst": "0.00", "cess": "0.00", "taxCharged": "180.00", "roundOff": "0.00", "grandTotal": "1180.00" } },
    { "name": "inter-state 5% with round-off", "ctx": { "supplierState": "27", "placeOfSupply": "29" },
      "lines": [{ "qty": "3", "rate": "333.33", "gstRate": "5" }],
      "expect": { "supplyKind": "inter", "taxableValue": "999.99", "cgst": "0.00", "sgst": "0.00", "utgst": "0.00", "igst": "50.00", "cess": "0.00", "taxCharged": "50.00", "roundOff": "0.01", "grandTotal": "1050.00" } },
    { "name": "intra-UT Chandigarh uses UTGST", "ctx": { "supplierState": "04", "placeOfSupply": "04" },
      "lines": [{ "qty": "1", "rate": "1000", "gstRate": "18" }],
      "expect": { "supplyKind": "intra", "taxableValue": "1000.00", "cgst": "90.00", "sgst": "0.00", "utgst": "90.00", "igst": "0.00", "cess": "0.00", "taxCharged": "180.00", "roundOff": "0.00", "grandTotal": "1180.00" } },
    { "name": "export under LUT is zero-rated", "ctx": { "supplierState": "27", "placeOfSupply": "96", "lut": true },
      "lines": [{ "qty": "1", "rate": "1000", "gstRate": "18" }],
      "expect": { "supplyKind": "export", "taxableValue": "1000.00", "cgst": "0.00", "sgst": "0.00", "utgst": "0.00", "igst": "0.00", "cess": "0.00", "taxCharged": "0.00", "roundOff": "0.00", "grandTotal": "1000.00" } },
    { "name": "reverse charge shows tax but does not charge it", "ctx": { "supplierState": "27", "placeOfSupply": "07", "reverseCharge": true },
      "lines": [{ "qty": "1", "rate": "10000", "gstRate": "18" }],
      "expect": { "supplyKind": "inter", "taxableValue": "10000.00", "cgst": "0.00", "sgst": "0.00", "utgst": "0.00", "igst": "1800.00", "cess": "0.00", "taxCharged": "0.00", "roundOff": "0.00", "grandTotal": "10000.00" } },
    { "name": "28% plus compensation cess (pre-GST 2.0 document)", "ctx": { "supplierState": "27", "placeOfSupply": "27" },
      "lines": [{ "qty": "1", "rate": "100000", "gstRate": "28", "cessRate": "22" }],
      "expect": { "supplyKind": "intra", "taxableValue": "100000.00", "cgst": "14000.00", "sgst": "14000.00", "utgst": "0.00", "igst": "0.00", "cess": "22000.00", "taxCharged": "50000.00", "roundOff": "0.00", "grandTotal": "150000.00" } },
    { "name": "half-paise rounding on each half", "ctx": { "supplierState": "27", "placeOfSupply": "27" },
      "lines": [{ "qty": "1", "rate": "10.05", "gstRate": "5" }],
      "expect": { "supplyKind": "intra", "taxableValue": "10.05", "cgst": "0.25", "sgst": "0.25", "utgst": "0.00", "igst": "0.00", "cess": "0.00", "taxCharged": "0.50", "roundOff": "0.45", "grandTotal": "11.00" } },
    { "name": "line discount, legacy 12%", "ctx": { "supplierState": "27", "placeOfSupply": "24" },
      "lines": [{ "qty": "2", "rate": "250", "discount": "50", "gstRate": "12" }],
      "expect": { "supplyKind": "inter", "taxableValue": "450.00", "cgst": "0.00", "sgst": "0.00", "utgst": "0.00", "igst": "54.00", "cess": "0.00", "taxCharged": "54.00", "roundOff": "0.00", "grandTotal": "504.00" } },
    { "name": "SEZ in the same state is still IGST", "ctx": { "supplierState": "27", "placeOfSupply": "27", "sez": true },
      "lines": [{ "qty": "1", "rate": "1000", "gstRate": "18" }],
      "expect": { "supplyKind": "sez", "taxableValue": "1000.00", "cgst": "0.00", "sgst": "0.00", "utgst": "0.00", "igst": "180.00", "cess": "0.00", "taxCharged": "180.00", "roundOff": "0.00", "grandTotal": "1180.00" } },
    { "name": "multiple lines, mixed rates, fractional qty, no round-off", "ctx": { "supplierState": "09", "placeOfSupply": "09", "roundOff": false },
      "lines": [{ "qty": "1.5", "rate": "99.99", "gstRate": "5" }, { "qty": "4", "rate": "12.35", "gstRate": "18" }],
      "expect": { "supplyKind": "intra", "taxableValue": "199.39", "cgst": "8.20", "sgst": "8.20", "utgst": "0.00", "igst": "0.00", "cess": "0.00", "taxCharged": "16.40", "roundOff": "0.00", "grandTotal": "215.79" } }
  ]
}
