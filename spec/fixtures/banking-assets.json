{
  "_comment": "Phase 7 rules: book and income-tax depreciation, bank statement reading and matching, gateway settlements. Figures worked out by hand.",
  "bookDepreciation": [
    {
      "name": "SLM laptop put to use mid-year: 57,000 over 3 years, 182 of 365 days",
      "asset": { "cost": "60000", "method": "slm", "lifeYears": "3", "residualPct": "5", "putToUseOn": "2026-10-01" },
      "period": { "fyStart": "2026-04-01", "fyEnd": "2027-03-31", "from": "2026-04-01", "to": "2027-03-31" },
      "accumulatedAtFyStart": "0", "accumulatedBefore": "0",
      "expect": { "amount": "9473.97", "days": 182 }
    },
    {
      "name": "WDV car, first full year at 1 - 0.05^(1/8)",
      "asset": { "cost": "800000", "method": "wdv", "lifeYears": "8", "residualPct": "5", "putToUseOn": "2026-04-01" },
      "period": { "fyStart": "2026-04-01", "fyEnd": "2027-03-31", "from": "2026-04-01", "to": "2027-03-31" },
      "accumulatedAtFyStart": "0", "accumulatedBefore": "0",
      "expect": { "amount": "249875.18", "days": 365 }
    },
    {
      "name": "WDV car, second year (leap year, 366 days) on the written down value",
      "asset": { "cost": "800000", "method": "wdv", "lifeYears": "8", "residualPct": "5", "putToUseOn": "2026-04-01" },
      "period": { "fyStart": "2027-04-01", "fyEnd": "2028-03-31", "from": "2027-04-01", "to": "2028-03-31" },
      "accumulatedAtFyStart": "249875.18", "accumulatedBefore": "249875.18",
      "expect": { "amount": "171828.17", "days": 366 }
    },
    {
      "name": "stops at the residual value",
      "asset": { "cost": "10000", "method": "slm", "lifeYears": "3", "residualPct": "5", "putToUseOn": "2024-04-01" },
      "period": { "fyStart": "2026-04-01", "fyEnd": "2027-03-31", "from": "2026-04-01", "to": "2027-03-31" },
      "accumulatedAtFyStart": "9000", "accumulatedBefore": "9000",
      "expect": { "amount": "500.00", "days": 365 }
    },
    {
      "name": "sold on 30 June: 91 days of 11,400 a year",
      "asset": { "cost": "120000", "method": "slm", "lifeYears": "10", "residualPct": "5", "putToUseOn": "2025-04-01", "disposedOn": "2026-06-30" },
      "period": { "fyStart": "2026-04-01", "fyEnd": "2027-03-31", "from": "2026-04-01", "to": "2027-03-31" },
      "accumulatedAtFyStart": "11400", "accumulatedBefore": "11400",
      "expect": { "amount": "2842.19", "days": 91 }
    },
    {
      "name": "a monthly run: October only",
      "asset": { "cost": "60000", "method": "slm", "lifeYears": "3", "residualPct": "5", "putToUseOn": "2026-10-01" },
      "period": { "fyStart": "2026-04-01", "fyEnd": "2027-03-31", "from": "2026-10-01", "to": "2026-10-31" },
      "accumulatedAtFyStart": "0", "accumulatedBefore": "0",
      "expect": { "amount": "1613.70", "days": 31 }
    }
  ],
  "disposal": { "cost": "120000", "accumulated": "14242.19", "saleValue": "100000", "expect": { "bookValue": "105757.81", "profit": "-5757.81" } },
  "itBlocks": [
    {
      "name": "computers 40%: an addition used under 180 days gets half the rate, sales come off first",
      "block": { "rate": "40", "openingWdv": "100000", "additions": [{ "cost": "50000", "putToUseOn": "2026-06-01" }, { "cost": "30000", "putToUseOn": "2026-12-15" }], "sales": ["20000"] },
      "fyEnd": "2027-03-31",
      "expect": { "openingWdv": "100000.00", "additionsFullRate": "50000.00", "additionsHalfRate": "30000.00", "sales": "20000.00", "depreciation": "58000.00", "closingWdv": "102000.00", "shortTermGain": "0.00", "shortTermLoss": "0.00" }
    },
    {
      "name": "the 180-day line: 3 October is 180 days to 31 March, 4 October is 179",
      "block": { "rate": "15", "openingWdv": "0", "additions": [{ "cost": "10000", "putToUseOn": "2026-10-03" }, { "cost": "10000", "putToUseOn": "2026-10-04" }], "sales": [] },
      "fyEnd": "2027-03-31",
      "expect": { "additionsFullRate": "10000.00", "additionsHalfRate": "10000.00", "depreciation": "2250.00", "closingWdv": "17750.00" }
    },
    {
      "name": "sales above the block's value: short-term capital gain, no depreciation",
      "block": { "rate": "15", "openingWdv": "10000", "additions": [], "sales": ["25000"] },
      "fyEnd": "2027-03-31",
      "expect": { "depreciation": "0.00", "closingWdv": "0.00", "shortTermGain": "15000.00" }
    },
    {
      "name": "every asset of the block sold: the rest is a short-term capital loss",
      "block": { "rate": "15", "openingWdv": "40000", "additions": [], "sales": ["30000"], "blockCeases": true },
      "fyEnd": "2027-03-31",
      "expect": { "depreciation": "0.00", "closingWdv": "0.00", "shortTermLoss": "10000.00" }
    }
  ],
