    { "slab": "apparel", "date": "2025-09-21", "value": "1000", "expect": "5" },
    { "slab": "apparel", "date": "2025-09-21", "value": "1000.01", "expect": "12" },
    { "slab": "apparel", "date": "2024-04-01", "value": "1800", "expect": "12" },
    { "slab": "footwear", "date": "2025-09-21", "value": "900", "expect": "12" },
