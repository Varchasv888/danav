    { "slab": "footwear", "date": "2026-10-01", "value": "2600", "expect": "18" }
  ],
  "inclusive": [
    { "slab": "apparel", "date": "2026-10-01", "price": "2600", "expect": "5" },
    { "slab": "apparel", "date": "2026-10-01", "price": "2625", "expect": "5" },
    { "slab": "apparel", "date": "2026-10-01", "price": "2625.01", "expect": "18" },
    { "slab": "apparel", "date": "2026-10-01", "price": "3500", "expect": "18" },
    { "slab": "apparel", "date": "2025-09-21", "price": "1050", "expect": "5" },
    { "slab": "apparel", "date": "2025-09-21", "price": "1100", "expect": "12" }
  ],
  "ambiguous": [
    { "slab": "apparel", "date": "2026-10-01", "price": "2600", "expect": false },
    { "slab": "apparel", "date": "2026-10-01", "price": "2700", "expect": true },
    { "slab": "apparel", "date": "2026-10-01", "price": "2950", "expect": true },
    { "slab": "apparel", "date": "2026-10-01", "price": "2950.01", "expect": false }
  ],
  "lineRate": [
    { "name": "no slab keeps the item rate", "item": { "gstRate": "12" }, "line": { "qty": "1", "rate": "5000" }, "date": "2026-10-01", "expect": "12" },
    { "name": "discount brings a Rs 3,000 shirt under the line", "item": { "gstRate": "5", "gstSlab": "apparel" }, "line": { "qty": "2", "rate": "3000", "discount": "1200" }, "date": "2026-10-01", "expect": "5" },
    { "name": "Rs 3,000 shirt without discount", "item": { "gstRate": "5", "gstSlab": "apparel" }, "line": { "qty": "2", "rate": "3000" }, "date": "2026-10-01", "expect": "18" },
    { "name": "set of four counted per piece", "item": { "gstRate": "5", "gstSlab": "apparel", "slabPieces": 4 }, "line": { "qty": "1", "rate": "8000" }, "date": "2026-10-01", "expect": "5" },
    { "name": "set of four counted as one piece", "item": { "gstRate": "5", "gstSlab": "apparel", "slabPieces": 1 }, "line": { "qty": "1", "rate": "8000" }, "date": "2026-10-01", "expect": "18" },
    { "name": "MRP-inclusive tag back-calculated", "item": { "gstRate": "5", "gstSlab": "apparel" }, "line": { "qty": "1", "rate": "2600" }, "date": "2026-10-01", "inclusive": true, "expect": "5" },
    { "name": "zero quantity tests the rate", "item": { "gstRate": "5", "gstSlab": "apparel" }, "line": { "qty": "0", "rate": "2700" }, "date": "2026-10-01", "expect": "18" }
  ],
  "posBill": [
    {
      "name": "bill discount moves one kurta under Rs 2,500",
      "options": { "inclusive": true, "billDiscount": "600", "date": "2026-10-01" },
      "lines": [
        { "qty": "1", "price": "2600", "gstRate": "5", "gstSlab": "apparel" },
