      "expectRates": ["5", "18"]
    },
    {
      "name": "exclusive prices with a line discount",
      "options": { "inclusive": false, "date": "2026-10-01" },
      "lines": [
        { "qty": "2", "price": "2800", "gstRate": "5", "gstSlab": "apparel", "discount": "700" },
        { "qty": "1", "price": "1200", "gstRate": "18" }
      ],
      "expectRates": ["5", "18"]
    }
  ]
